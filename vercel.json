{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci --prefix prototype",
  "buildCommand": "npm run build:web --prefix prototype",
  "outputDirectory": "prototype/dist",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
